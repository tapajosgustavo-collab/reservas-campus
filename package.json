{
  "name": "reservas-campus",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "ferramentas/*",
    "e2e"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @reservas/api\" \"npm run dev -w @reservas/web\"",
    "lint": "eslint . && prettier --check . && npm run typecheck --workspaces",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:nucleo": "vitest run --project nucleo --coverage",
    "test:api": "vitest run --project api",
    "test:e2e": "npm run test:e2e -w @reservas/e2e",
    "build": "npm run build -w @reservas/web",
    "quadro": "npm run gerar -w @reservas/quadro",
    "seguranca": "audit-ci --config ./audit-ci.jsonc"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "audit-ci": "^7.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
