# Copie para .env e ajuste se precisar. O .env não vai para o Git.

# Porta da API. O Vite (tela, porta 5173) repassa /api para ela.
PORT=3000
# Endereço em que a API escuta. Em contêiner use 0.0.0.0.
HOST=localhost

# SHA do commit em execução, devolvido por GET /api/health.
# No Render vem de RENDER_GIT_COMMIT; vazio, a API responde "local".
GIT_SHA=

# Banco do dia a dia: o do `docker compose up -d db`.
DATABASE_URL=postgresql://reservas:reservas@localhost:5432/reservas
# Banco dos testes. É esvaziado a cada teste: nunca aponte para o do dia a dia.
# Sem ele, os testes que precisam de banco são pulados.
DATABASE_URL_TESTE=postgresql://reservas:reservas@localhost:5432/reservas_teste

# Segredo do cookie de sessão, com pelo menos 32 bytes. Este valor só serve na sua máquina;
# o de produção fica só no Render.
SEGREDO_SESSAO=so-para-desenvolvimento-troque-em-producao

# Demo: com DEMO=1 o relógio fica parado em RELOGIO_FIXO (ISO com deslocamento) e só anda
# por POST /api/demo/relogio. Nunca em produção.
DEMO=0
RELOGIO_FIXO=
